POSTGRES_DB="world_cup_predictor"
POSTGRES_USER="world_cup"
POSTGRES_PASSWORD='replace-with-a-long-random-database-password'
POSTGRES_PORT="5432"
APP_PORT="3000"

# Required only when applying compose.production.yaml.
WORLD_CUP_HOST="copa.example.com"
POSTGRES_DATA_PATH="./data"
TZ="America/Fortaleza"

AUTH_URL="http://localhost:3000"
AUTH_SECRET='replace-with-a-long-random-secret'

AUTH_KEYCLOAK_ID="world-cup-predictor-web"
AUTH_KEYCLOAK_SECRET='replace-with-keycloak-client-secret'
AUTH_KEYCLOAK_ISSUER="https://keycloak.example.com/realms/world-cup-predictor"

# Required for the internal Docker worker that triggers automatic score sync.
MATCH_SYNC_SECRET='replace-with-a-long-random-sync-secret'
# Optional override for tests/proxies. Defaults to ESPN's public FIFA World Cup scoreboard endpoint.
ESPN_SCOREBOARD_BASE_URL=""

# Optional: enables Google Analytics for Firebase after explicit browser consent.
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN=""
FIREBASE_PROJECT_ID=""
FIREBASE_MESSAGING_SENDER_ID=""
FIREBASE_APP_ID=""
FIREBASE_MEASUREMENT_ID=""
