POSTGRES_DB="world_cup_predictor"
POSTGRES_USER="world_cup"
POSTGRES_PASSWORD="replace-with-url-safe-database-password"
POSTGRES_PORT="5432"
APP_PORT="3000"

# Required only when applying compose.production.yaml.
WORLD_CUP_HOST="copa.example.com"
POSTGRES_DATA_PATH="./data"
TZ="America/Fortaleza"

DATABASE_URL="postgresql://world_cup:replace-with-url-safe-database-password@localhost:5432/world_cup_predictor?schema=public"
AUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"

AUTH_KEYCLOAK_ID="world-cup-predictor-web"
AUTH_KEYCLOAK_SECRET="replace-with-keycloak-client-secret"
AUTH_KEYCLOAK_ISSUER="https://keycloak.example.com/realms/world-cup-predictor"
