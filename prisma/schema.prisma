generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchStage {
  GROUP_STAGE
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINALS
  SEMI_FINALS
  THIRD_PLACE_MATCH
  FINAL
}

enum MatchStatus {
  SCHEDULED
  STARTED
  FINISHED
}

enum GroupCode {
  A
  B
  C
  D
  E
  F
  G
  H
  I
  J
  K
  L
}

model User {
  id                String         @id @default(cuid())
  keycloakId        String         @unique
  name              String
  email             String?        @unique
  image             String?
  favoriteTeam      String?
  predictedChampion String?
  predictions       Prediction[]
  ownedFriendGroups       FriendGroup[]       @relation("FriendGroupOwner")
  friendGroupMemberships  FriendGroupMember[]
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)
  hiddenFromGlobalRanking Boolean @default(false)
}

model Match {
  id                    String       @id @default(cuid())
  matchNumber           Int          @unique
  fifaMatchId           String       @unique
  teamA                 String?
  teamB                 String?
  teamASlot             String?
  teamBSlot             String?
  participantsConfirmed Boolean      @default(false)
  stage                 MatchStage
  groupCode             GroupCode?
  groupRound            Int?
  startsAt              DateTime     @db.Timestamptz(3)
  venue                 String
  hostCity              String
  status                MatchStatus  @default(SCHEDULED)
  teamAScore            Int?
  teamBScore            Int?
  advancingTeam         String?
  predictionsResetAt    DateTime?    @db.Timestamptz(3)
  predictions           Prediction[]
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, startsAt])
  @@index([stage])
  @@index([groupCode, groupRound])
}

model Prediction {
  id         String   @id @default(cuid())
  userId     String
  matchId    String
  teamAScore Int
  teamBScore Int
  predictedAdvancingTeam String?
  points     Int      @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  match      Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId])
}

model FriendGroup {
  id              String         @id @default(cuid())
  name            String
  ownerId         String
  inviteTokenHash String?        @unique
  owner           User                @relation("FriendGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         FriendGroupMember[]
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  @@index([ownerId])
}

model FriendGroupMember {
  friendGroupId String
  userId        String
  joinedAt      DateTime    @default(now()) @db.Timestamptz(3)
  friendGroup   FriendGroup @relation(fields: [friendGroupId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([friendGroupId, userId])
  @@index([userId])
}
